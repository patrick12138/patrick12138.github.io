dPost":true,"apiUrl":"/youtubei/v1/browse/edit_playlist"}},"playlistEditEndpoint":{"playlistId":"WL","actions":[{"addedVideoId":"SpKtpW9TGF0","action":"ACTION_ADD_VIDEO"}]}},"removeFromWatchLaterCommand":{"clickTrackingParams":"CAAQu2kiEwiMwtGZjuiXAxUIWw8CHSB9KiTKAQRh1uDN","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/browse/edit_playlist"}},"playlistEditEndpoint":{"playlistId":"WL","actions":[{"action":"ACTION_REMOVE_VIDEO_BY_VIDEO_ID","removedVideoId":"SpKtpW9TGF0"}]}}}}},"storyboards":{"playerStoryboardSpecRenderer":{"spec":"https://i.ytimg.com/sb/SpKtpW9TGF0/storyboard3_L$L/$N.jpg?sqp=-oaymwENSDfyq4qpAwVwAcABBqLzl_8DBgjmw4u6Bg==|48#27#100#10#10#0#default#rs$AOn4CLAABzQOURSD7zNo2__juv1uCxMA_Q|80#45#153#10#10#10000#M$M#rs$AOn4CLANHPB_Hrr4ObDkvyxA3cJ_2mC2vA|160#90#153#5#5#10000#M$M#rs$AOn4CLBA1tQvQdklV_uTL5D7Tg7ittFnDg|320#180#153#3#3#10000#M$M#rs$AOn4CLAnILNG5cBZU0y4G32Xo7c1knI8Dw","recommendedLevel":3,"fineScrubbingRecommendedLevel":2,"highResolutionRecommendedLevel":3}},"microformat":{"playerMicroformatRenderer":{"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/SpKtpW9TGF0/maxresdefault.jpg","width":1280,"height":720}]},"embed":{"iframeUrl":"https://www.youtube.com/embed/SpKtpW9TGF0","width":1280,"height":720},"title":{"simpleText":"Addy Osmani – The Ai-Assisted Developer Workflow: Build Faster and Smarter Today, JSNation US 2024"},"description":{"simpleText":"JSNation US 2024 #JSNationUS #GitNation\nWebsite – https://jsnation.us/\n\nFollow the link to watch the full version of all the conference talks, QnA’s with speakers and hands-on workshop recordings → https://gitnation.com/events/jsnation-us-2024\n\nTalk: The Ai-Assisted Developer Workflow: Build Faster and Smarter Today\nUnlock the next generation of developer productivity. In this talk, we'll dive into how AI-powered tools are transforming the way we build software. Discover techniques for rapid iteration, intelligent debugging, and the creation of exceptional user experiences. Whether you're using cutting-edge AI models or exploring the first wave of AI assistance, this talk will equip you with strategies to level up your workflow.\n\nTimestamps:\n\n0:00 AI's Impact on Software Engineering\n2:31 Understanding Agents and Their Role\n4:51 Collaborative AI and Automating Code with Agents\n7:58 v0: Building Components and Interactive Prototypes\n9:49 v0 and Bolt: Beyond Component Building\n11:58 Bolt's Troubleshooting and Authentication Features\n14:19 Bolt's Targeted Edits and Tips\n15:28 Code Generation with Copilot and Cursor\n18:19 Optimizing Cursor Setup and Introducing Cline\n20:48 Website Inspection and Testing with Cline\n\n🔥 Want to hear talks like this live? Join us at JSNation US 2025 in New York: https://jsnation.us/?utm_source=youtube\u0026utm_medium=addyosmani\n\nJSNation website: https://jsnation.com\nJSNation on X: https://x.com/thejsnation\nJSNation on LinkedIn: https://www.linkedin.com/showcase/jsnation-the-main-js-conference/\nJSNation on Bluesky: https://bsky.app/profile/jsnation.gitnation.org\nJSNation on Instagram: https://www.instagram.com/thejsnation/\nGitNation on TikTok: https://www.tiktok.com/@gitnationorg\n\n#JSNation #TechTalks #GitNation #JSNation2025"},"lengthSeconds":"1517","ownerProfileUrl":"http://www.youtube.com/@JavaScriptConferences","externalChannelId":"UCQM428Hwrvxla8DCgjGONSQ","isFamilySafe":true,"availableCountries":["AD","AE","AF","AG","AI","AL","AM","AO","AQ","AR","AS","AT","AU","AW","AX","AZ","BA","BB","BD","BE","BF","BG","BH","BI","BJ","BL","BM","BN","BO","BQ","BR","BS","BT","BV","BW","BY","BZ","CA","CC","CD","CF","CG","CH","CI","CK","CL","CM","CN","CO","CR","CU","CV","CW","CX","CY","CZ","DE","DJ","DK","DM","DO","DZ","EC","EE","EG","EH","ER","ES","ET","FI","FJ","FK","FM","FO","FR","GA","GB","GD","GE","GF","GG","GH","GI","GL","GM","GN","GP","GQ","GR","GS","GT","GU","GW","GY","HK","HM","HN","HR","HT","HU","ID","IE","IL","IM","IN","IO","IQ","IR","IS","IT","JE","JM","JO","JP","KE","KG"