r":{"panelIdentifier":"engagement-panel-structured-description","content":{"structuredDescriptionContentRenderer":{"items":[{"videoTitleHeaderViewModel":{"videoTitle":{"content":"Addy Osmani – The Ai-Assisted Developer Workflow: Build Faster and Smarter Today, JSNation US 2024"},"headerButton":{"buttonViewModel":{"iconName":"CLOSE","onTap":{"innertubeCommand":{"clickTrackingParams":"CEEQiPkBIhMI8N_RmY7olwMV1csWBR1b3CYyygEEYdbgzQ==","hideEngagementPanelEndpoint":{"panelIdentifier":"engagement-panel-structured-description"}}},"accessibilityText":"關閉","style":"BUTTON_VIEW_MODEL_STYLE_MONO","trackingParams":"CEEQiPkBIhMI8N_RmY7olwMV1csWBR1b3CYy","type":"BUTTON_VIEW_MODEL_TYPE_TEXT","buttonSize":"BUTTON_VIEW_MODEL_SIZE_DEFAULT","loggingDirectives":{"trackingParams":"CEEQiPkBIhMI8N_RmY7olwMV1csWBR1b3CYy","visibility":{"types":"12"}}}},"rendererContext":{"loggingContext":{"loggingDirectives":{"trackingParams":"CEAQ0f0TGAAiEwjw39GZjuiXAxXVyxYFHVvcJjI=","visibility":{"types":"12"}}}}}},{"videoDescriptionHeaderRenderer":{"channel":{"simpleText":"JavaScript Conferences by GitNation"},"views":{"simpleText":"收看次數：25,200 次"},"publishDate":{"simpleText":"2024年11月28日"},"factoid":[{"factoidRenderer":{"value":{"simpleText":"731"},"label":{"simpleText":"喜歡次數"},"accessibilityText":"731 人表示喜歡","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED"}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"EgtTcEt0cFc5VEdGMCDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"25K"},"label":{"simpleText":"收看次數"},"accessibilityText":"收看次數：25,200 次","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED"}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2024年"},"label":{"simpleText":"11月28日"},"accessibilityText":"2024年11月28日","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","position":"FACTOID_POSITION_LAST"}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAciEwjw39GZjuiXAxXVyxYFHVvcJjLKAQRh1uDN","commandMetadata":{"webCommandMetadata":{"url":"/@JavaScriptConferences","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCQM428Hwrvxla8DCgjGONSQ","canonicalBaseUrl":"/@JavaScriptConferences"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/-tNKqhMn9OSnChx0ArkcR9vOk9iYyfDcnGvjWDdbpvBpNwt5CXENEYpssW2NyHY97I-zUcUz=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"顯示更多"}},"simpleText":"...更多"},"showLessText":{"simpleText":"顯示較少"},"attributedDescriptionBodyText":{"content":"JSNation US 2024 #JSNationUS #GitNation\nWebsite – https://jsnation.us/\n\nFollow the link to watch the full version of all the conference talks, QnA’s with speakers and hands-on workshop recordings → https://gitnation.com/events/jsnation...\n\nTalk: The Ai-Assisted Developer Workflow: Build Faster and Smarter Today\nUnlock the next generation of developer productivity. In this talk, we'll dive into how AI-powered tools are transforming the way we build software. Discover techniques for rapid iteration, intelligent debugging, and the creation of exceptional user experiences. Whether you're using cutting-edge AI models or exploring the first wave of AI assistance, this talk will equip you with strategies to level up your workflow.\n\nTimestamps:\n\n0:00 AI's Impact on Software Engineering\n2:31 Understanding Agents and Their Role\n4:51 Collaborative AI and Automating Code with Agents\n7:58 v0: Building Components and Interactive Prototypes\n9:49 v0 and Bolt: Beyond Component Building\n11:58 Bolt's Troubleshooting and Authentication Features\n14:19 Bolt's Targeted Edits and Tips\n15:28 Code Generation with Copilot and Cursor\n18:19 Optimizing Cursor Setup and Introducing Cline\n20:48 Website Inspection and Testing with Cline\n\n🔥 Want to hear talks like this live? Join us at JSNation US 2025 in New York: https://jsnation.us/?utm_source=youtu...\n\nJSNation website: https://jsnation.com\nJSNation on X: https://x.com/thejsnation\nJSNation on LinkedIn:   / jsnation-the-main-js-conference  \nJSNation on Bluesky: https://bsky.app/profile/jsnation.git...\nJSNation on Instagram:   / thejsnation  \nGitNation on TikTok:   / gitnationorg  \n\n#JSNation #TechTalks #GitNation #JSNation2025","commandRuns":[{"startIndex":17,"length":11,"onTap":{"innertubeCommand":{"clickTrackingParams":"CD8Q3NcEGI4BIhMI8N_RmY7olwMV1csWBR1b3CYyygEEYdbgzQ==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/jsnationus","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUOCgpqc25hdGlvbnVzGAE%3D"}}},"loggingDirectives":{"trackingParams":"CD8Q3NcEGI4BIhMI8N_RmY7olwMV1csWBR1b3CYy"}},{"startIndex":29,"length":10,"onTap":{"innertubeCommand":{"clickTrackingParams":"CD4Q3NcEGI8BIhMI8N_RmY7olwMV1csWBR1b3CYyygEEYdbgzQ==","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/gitnation","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUNCglnaXRuYXRpb24YAQ%3D%3D"}}},"loggingDirectives":{"trackingParams":"CD4Q3NcEGI8BIhMI8N_RmY7olwMV1csWBR1b3CYy"}},{"startIndex":50,"length":20,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAciEwjw39GZjuiXAxXVyxYFHVvcJjJI3bDM-ta0q8lKygEEYdbgzQ==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUlxb01IWVdBSWYwNzJjQWVBLWpONXYwcEotSHxBSTVJdTVzbmZTQnJheUlZLWpCQjRQZ2JFQ1Zha3kzRmZrS29ZanBIOVVzWG1IQXotX0cxbElUeFJnWXFhS2t2YWRBVlUzVUtBN0doajRiZHFtLURZbS1mZWN1X3RncXQtTTh2\u0026q=https%3A%2F%2Fjsnation.us%2F\u0026v=SpKtpW9TGF0","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUlxb01IWVdBSWYwNzJjQWVBLWpONXYwcEotSHxBSTVJdTVzbmZTQnJheUlZLWpCQjRQZ2JFQ1Zha