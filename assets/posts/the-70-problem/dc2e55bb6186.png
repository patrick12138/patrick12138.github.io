uttonRenderer":{"style":"STYLE_BLUE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"取消訂閱"}]},"serviceEndpoint":{"clickTrackingParams":"CLACEPBbIhMI8N_RmY7olwMV1csWBR1b3CYyKPgdMgV3YXRjaMoBBGHW4M0=","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/unsubscribe"}},"unsubscribeEndpoint":{"channelIds":["UCQM428Hwrvxla8DCgjGONSQ"],"params":"CgIIAxILU3BLdHBXOVRHRjAYAA%3D%3D"}},"accessibility":{"label":"取消訂閱"},"trackingParams":"CLACEPBbIhMI8N_RmY7olwMV1csWBR1b3CYy"}},"cancelButton":{"buttonRenderer":{"style":"STYLE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"取消"}]},"accessibility":{"label":"取消"},"trackingParams":"CK8CEPBbIhMI8N_RmY7olwMV1csWBR1b3CYy"}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}],"timedAnimationData":{"animationTiming":[1021040],"macroMarkersIndex":[0],"animationDurationSecs":1.5,"borderStrokeThicknessDp":2,"borderOpacity":1,"fillOpacity":0,"trackingParams":"CK0CEPBbIhMI8N_RmY7olwMV1csWBR1b3CYy","animationOrigin":"ANIMATION_ORIGIN_SMARTIMATION"}}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0,"trackingParams":"CKUCEM2rARgBIhMI8N_RmY7olwMV1csWBR1b3CYy"}},"showMoreText":{"simpleText":"更多"},"showLessText":{"simpleText":"顯示較少"},"trackingParams":"CKUCEM2rARgBIhMI8N_RmY7olwMV1csWBR1b3CYy","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CKUCEM2rARgBIhMI8N_RmY7olwMV1csWBR1b3CYyygEEYdbgzQ==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CKUCEM2rARgBIhMI8N_RmY7olwMV1csWBR1b3CYyygEEYdbgzQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CKUCEM2rARgBIhMI8N_RmY7olwMV1csWBR1b3CYyygEEYdbgzQ==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CKUCEM2rARgBIhMI8N_RmY7olwMV1csWBR1b3CYyygEEYdbgzQ==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"JSNation US 2024 #JSNationUS #GitNation\nWebsite – https://jsnation.us/\n\nFollow the link to watch the full version of all the conference talks, QnA’s with speakers and hands-on workshop recordings → https://gitnation.com/events/jsnation...\n\nTalk: The Ai-Assisted Developer Workflow: Build Faster and Smarter Today\nUnlock the next generation of developer productivity. In this talk, we'll dive into how AI-powered tools are transforming the way we build software. Discover techniques for rapid iteration, intelligent debugging, and the creation of exceptional user experiences. Whether you're using cutting-edge AI models or exploring the first wave of AI assistance, this talk will equip you with strategies to level up your workflow.\n\nTimestamps:\n\n0:00 AI's Impact on Software Engineering\n2:31 Understanding Agents and Their Role\n4:51 Collaborative AI and Automating Code with Agents\n7:58 v0: Building Components and Interactive Prototypes\n9:49 v0 and Bolt: Beyond Component Building\n11:58 Bolt's Troubleshooting and Authentication Features\n14:19 Bolt's Targeted Edits and Tips\n15:28 Code Generation with Copilot and Cursor\n18:19 Optimizing Cursor Setup and Introducing Cline\n20:48 Website Inspection and Testing with Cline\n\n🔥 Want to hear talks like this live? Join us at JSNation US 2025 in New York: https://jsnation.us/?utm_source=youtu...\n\nJSNation website: https://jsnation.com\nJSNation on X: https://x.com/thejsnation\nJSNation on LinkedIn:   / jsnation-the-main-js-conference  \nJSNation on Bluesky: https://bsky.app/profile/jsnation.git...\nJSNation on Instagram:   / thejsnation  \nGitNation on TikTok:   / gitnationorg  \n\n#JSNation #TechTalks #GitNation #JSNation2025","commandRuns":[{"startIndex":17,"length":11,"onTap":{"innertubeCommand":{"clickTracki